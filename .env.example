# ══════════════════════════════════════════════════════════════════
#  SOLSCRAPER — Configuration
#  Copie ce fichier en .env et remplis les valeurs
# ══════════════════════════════════════════════════════════════════

# ── Serveur ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Helius API (REQUIS pour le tracking temps réel) ───────────────
# Inscription gratuite : https://helius.dev
# Free tier : 100 RPS, 10M credits/mois
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── Birdeye API (REQUIS pour prix + découverte wallets) ───────────
# Inscription : https://birdeye.so/developers
# Free tier disponible
BIRDEYE_API_KEY=your_birdeye_api_key_here

# ── Wallet de trading (OPTIONNEL — pour copy trade automatique) ───
# ⚠️  IMPORTANT: Ne jamais partager cette clé privée !
# ⚠️  Commence avec un wallet vide pour tester
# Clé privée en base58 (depuis Phantom: Settings → Export Private Key)
TRADER_PRIVATE_KEY=your_base58_private_key_here
TRADER_WALLET_ADDRESS=your_wallet_public_address_here

# ── Sécurité ──────────────────────────────────────────────────────
# Montant max SOL par trade (protection)
MAX_SOL_PER_TRADE=1.0

# Slippage par défaut en basis points (300 = 3%)
DEFAULT_SLIPPAGE_BPS=300

# Liquidité minimale en USD pour accepter un trade
MIN_LIQUIDITY_USD=10000

# ── Base de données ───────────────────────────────────────────────
DB_PATH=./data/solscraper.db
